  "transform": [
    {
      "calculate": "datum.state === 'VIC' ? 'VIC' : datum.state === 'QLD' ? 'QLD' : datum.state === 'WA' ? 'WA' : 'Other States'",
      "as": "state_group"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "#f5f7fa",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "passengers",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              26000000
            ]
          },
          "axis": {
            "title": "Annual Passengers (2024)",
            "format": "~s",
            "values": [
              0,
              5000000,
              10000000,
              15000000,
              20000000,
              25000000
            ],
            "grid": true
          }
        },
        "y": {
          "field": "otp_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              58,
              82
            ]
          },
          "axis": {
            "title": "On-Time Departure Rate (%)",
            "grid": true
          }
        },
        "size": {
          "field": "sectors_flown",
          "type": "quantitative",
          "scale": {
            "range": [
              60,
              2200
            ]
          },
          "legend": {
            "title": "Sectors Flown",
            "orient": "right",
            "values": [
              0,
              20000,
              40000,
              60000,
              80000
            ]
          }
        },
        "color": {
          "field": "state_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "VIC",
              "QLD",
              "WA",
              "Other States"
            ],
            "range": [
              "#56c0b5",
              "#e8b84b",
              "#5f86b3",
              "#9aa5b1"
            ]
          },
          "legend": {
            "title": "State Group",
            "orient": "right"
          }
        },
        "opacity": {
          "value": 0.9
        },
        "tooltip": [
          {
            "field": "airport",
            "title": "Airport"
          },
          {
            "field": "passengers",
            "title": "Passengers",
            "format": ","
          },
          {
            "field": "otp_pct",
            "title": "On-Time %",
            "format": ".1f"
          },
          {
            "field": "sectors_flown",
            "title": "Sectors Flown",
            "format": ","
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "state_group",
            "title": "State Group"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.passengers > 5000000"
        }
      ],
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 11,
        "fontWeight": "bold",
        "dx": 8,
        "dy": -10,
        "align": "left",
        "color": "#f5f7fa"
      },
      "encoding": {
        "x": {
          "field": "passengers",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              26000000
            ]
          }
        },
        "y": {
          "field": "otp_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              58,
              82
            ]
          }
        },
        "text": {
          "field": "airport"
        },
        "opacity": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "passengers": 12400000,
            "otp_pct": 60.0,
            "note": "Major hubs carry the most passengers, but higher traffic does not always mean stronger on-time performance."
