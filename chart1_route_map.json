      "transform": [
        {
          "calculate": "(datum.lon1 + datum.lon2) / 2",
          "as": "mid_lon"
        },
        {
          "calculate": "((datum.lat1 + datum.lat2) / 2) + min(max(abs(datum.lon2 - datum.lon1) * 0.18, 2.2), 7.0)",
          "as": "mid_lat"
        },
        {
          "calculate": "[datum.lon1, datum.mid_lon, datum.lon2]",
          "as": "curve_lons"
        },
        {
          "calculate": "[datum.lat1, datum.mid_lat, datum.lat2]",
          "as": "curve_lats"
        },
        {
          "calculate": "[1, 2, 3]",
          "as": "curve_order"
        },
        {
          "calculate": "datum.tier == 'Major' ? 'Major (3.5M\u20138.0M Passengers)' : datum.tier == 'Large' ? 'Large (1.1M\u20132.5M Passengers)' : 'Medium (0.2M\u20130.9M Passengers)'",
          "as": "tierLabel"
        },
        {
          "flatten": [
            "curve_lons",
            "curve_lats",
            "curve_order"
          ],
          "as": [
            "curve_lon",
            "curve_lat",
            "curve_pt"
          ]
        }
