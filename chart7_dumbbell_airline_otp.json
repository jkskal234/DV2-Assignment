          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 6,
        "dy": -18,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#777777"
      },
      "encoding": {
        "x": {
          "field": "national_avg_2024",
