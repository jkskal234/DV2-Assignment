    {
      "mark": {
        "type": "rule",
        "color": "#CFCFCF",
        "size": 4
      },
      "encoding": {
        "y": {
          "field": "airline",
          "type": "nominal",
          "sort": [
            "Virgin Australia",
            "Rex Airlines",
            "QantasLink",
            "Qantas",
            "Jetstar"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelPadding": 8
          }
        },
        "x": {
          "field": "otp_2024",
          "type": "quantitative",
          "scale": {
            "domain": [
              64,
              90
            ]
          },
