        "y": {
          "field": "airline",
          "type": "nominal",
          "sort": [
            "Virgin Australia",
            "Rex Airlines",
            "QantasLink",
            "Qantas",
            "Jetstar"
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "labelPadding": 8
          }
        },
        "x": {
          "field": "otp",
          "type": "quantitative",
          "scale": {
            "domain": [
              64,
              90
            ]
          }
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "scale": {
            "domain": [
              "2019",
              "2024"
            ],
            "range": [
              "#1F6F5F",
              "#C9A227"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-right",
            "direction": "horizontal",
            "labelFontSize": 13,
            "symbolSize": 180,
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {
            "field": "airline",
            "type": "nominal",
            "title": "Airline"
          },
          {
            "field": "year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "otp",
            "type": "quantitative",
            "title": "On-Time Rate (%)",
            "format": ".1f"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change from 2019 to 2024 (pts)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.change, '.1f') + ' pts'",
          "as": "change_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -12,
        "fontSize": 12,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "color": "#4F4F4F"
      },
      "encoding": {
        "y": {
          "field": "airline",
          "type": "nominal",
          "sort": [
            "Virgin Australia",
            "Rex Airlines",
            "QantasLink",
            "Qantas",
            "Jetstar"
          ]
        },
        "x": {
          "field": "otp_2024",
          "type": "quantitative"
        },
        "text": {
          "field": "change_label"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#222222",
      "titleColor": "#111111"
    }
  }
