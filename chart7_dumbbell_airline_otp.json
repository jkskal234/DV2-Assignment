            "otp_2024"
          ],
          "as": [
            "year_key",
            "otp"
          ]
        },
        {
          "calculate": "datum.year_key == 'otp_2019' ? '2019' : '2024'",
          "as": "year"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 170,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.2
