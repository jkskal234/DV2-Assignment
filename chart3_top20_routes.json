      "encoding": {
        "y": {
          "field": "rankedRoute",
          "type": "ordinal",
          "sort": "ascending"
        },
        "x": {
          "field": "labelX",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8500000
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
