  "transform": [
    {
      "calculate": "format(datum.rank, '02') + '. ' + datum.route",
      "as": "rankedRoute"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "y": {
          "field": "rankedRoute",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelColor": "#f5f7fa",
            "labelExpr": "replace(datum.label, /^[0-9]+\\. /, '')"
          }
        },
        "x": {
          "field": "passengers",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8500000
            ]
          },
          "axis": {
            "title": "Annual Passengers (2024)",
            "format": "~s",
            "values": [
              0,
              2000000,
              4000000,
              6000000,
              8000000
            ],
            "grid": true
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Interstate",
              "Intrastate"
            ],
            "range": [
              "#5f86b3",
              "#56c0b5"
            ]
          },
          "legend": {
            "title": "Route Type",
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "rank",
            "title": "Rank"
          },
          {
            "field": "route",
            "title": "Route"
          },
          {
            "field": "passengers",
            "title": "Passengers",
            "format": ","
          },
          {
            "field": "category",
            "title": "Type"
          }
        ]
      }
    },
