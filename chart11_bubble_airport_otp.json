  "transform": [
    {
      "calculate": "datum.sectors >= 50000 ? 'Major' : datum.sectors >= 10000 ? 'Large' : datum.sectors >= 3000 ? 'Medium' : 'Small'",
      "as": "traffic_tier"
    },
    {
      "calculate": "datum.traffic_tier == 'Major' ? 'Major: 50k+ sectors' : datum.traffic_tier == 'Large' ? 'Large: 10k\u201349k sectors' : datum.traffic_tier == 'Medium' ? 'Medium: 3k\u20139.9k sectors' : 'Small: under 3k sectors'",
      "as": "tier_description"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "otp",
          "as": "avg_otp"
        },
        {
          "op": "count",
          "field": "airport",
          "as": "airport_count"
        },
        {
          "op": "sum",
          "field": "sectors",
          "as": "total_sectors"
        }
      ],
      "groupby": [
        "state",
        "traffic_tier",
        "tier_description"
      ]
    },
    {
      "calculate": "format(datum.avg_otp, '.2f') + '%'",
      "as": "otp_label"
    },
    {
      "calculate": "55 + (datum.avg_otp - 55) / 2",
      "as": "label_y"
    }
  ],
